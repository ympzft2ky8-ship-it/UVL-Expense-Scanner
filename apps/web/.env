# Firebase web app settings (Project settings -> Your apps -> Web app -> Config).
# These identify the project; they are not secrets. Access is controlled by
# firebase/firestore.rules. See docs/setup.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
